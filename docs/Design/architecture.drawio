        <mxCell id="r-e2" value="1. cache GET (hit → return)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#10b981;fontColor=#047857;endArrow=block;" edge="1" parent="1" source="r-rec" target="r-cache"><mxGeometry relative="1" as="geometry" /></mxCell>
