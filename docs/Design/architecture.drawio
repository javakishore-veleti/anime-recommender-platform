        <mxCell id="r-e4" value="3. context" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;fontColor=#4c1d95;endArrow=block;" edge="1" parent="1" source="r-vec" target="r-prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-e5" value="4. generate" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ef4444;fontColor=#7f1d1d;endArrow=block;" edge="1" parent="1" source="r-prompt" target="r-groq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-e6" value="5. answer + cache SET" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#10b981;fontColor=#047857;endArrow=block;" edge="1" parent="1" source="r-groq" target="r-resp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-e7" value="6. response" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4f46e5;fontColor=#3730a3;endArrow=block;" edge="1" parent="1" source="r-resp" target="r-cust"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ================================================================= -->
  <!-- TAB 5 — Infra & Observability                                     -->
  <!-- ================================================================= -->
  <diagram name="5 · Infra &amp; Observability" id="infra">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-title" value="Local Infra (Docker) — reuse if running · isolate by namespace · per-component compose" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1e1b4b;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f-note" value="Each component runs under a unique compose project  anime-&lt;component&gt;  →  shutdown never touches other repos&#39; containers (e.g. vkp-*).&#10;docker-all-up.sh reuses any container already on the port instead of starting a duplicate." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#4c4a7a;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- core group -->
        <mxCell id="f-core" value="core  (started by containers:start-all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#10b981;dashed=1;verticalAlign=top;fontColor=#047857;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="f-pg" value="Postgres :5433  (postgres:16)&#10;db postgres · schema anime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f-redis" value="Redis :6379  (redis:7-alpine)&#10;keys anime:*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f-corelbl" value="namespacing: Postgres → schema  ·  Redis → key prefix" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="420" height="20" as="geometry" /></mxCell>

        <!-- observability group -->
        <mxCell id="f-obs" value="observability  (OPT-IN — containers:observability:start-all · heavy on RAM/disk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;dashed=1;verticalAlign=top;fontColor=#92600a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="500" height="320" as="geometry" />
        </mxCell>
        <mxCell id="f-prom" value="Prometheus :9090&#10;scrapes /metrics  (label namespace=anime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="f-graf" value="Grafana :3000&#10;dashboards (Prom + Loki)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="f-loki" value="Loki :3100 + promtail&#10;logs (label namespace=anime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="f-jaeger" value="Jaeger :16686 (OTLP :4318)&#10;traces  service.namespace=anime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="f-es" value="Elasticsearch :9200&#10;index anime-logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="560" y="310" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="f-kib" value="Kibana :5601&#10;log search (ELK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#92600a;" vertex="1" parent="1"><mxGeometry x="800" y="310" width="220" height="60" as="geometry" /></mxCell>

        <!-- native services -->
        <mxCell id="f-svc" value="Middleware services + portals  (NATIVE — not in Docker)&#10;services :8001/8002/8003 · portals :5200/5201" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#06b6d4;fontColor=#0e2a3a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- orchestration -->
        <mxCell id="f-orch" value="Orchestration — root package.json  (localhost:&lt;group&gt;:&lt;action&gt;)&#10;&#10;containers:start-all / stop-all / status-all      (core; observability opt-in)&#10;services:start-all / stop-all / status-all        (native uvicorn daemons + worker)&#10;portals:start-all / stop-all / status-all         (native ng serve)&#10;→ DevOps/Localhost/*.sh  +  Services/*.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#1e1b4b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1000" height="150" as="geometry" />
