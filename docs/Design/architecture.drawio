        <mxCell id="f-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#06b6d4;endArrow=block;" edge="1" parent="1" source="f-svc" target="f-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
