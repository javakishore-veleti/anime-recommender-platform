        <mxCell id="f-e2" value="logs" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#f59e0b;fontColor=#92600a;endArrow=open;" edge="1" parent="1" source="f-svc" target="f-loki"><mxGeometry relative="1" as="geometry" /></mxCell>
