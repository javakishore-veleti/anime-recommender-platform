# ============================================================================
# anime-recommender-platform — environment template
# Copy to .env and fill in the secrets:  cp .env.example .env
# ============================================================================

# ---- LLM (Groq) -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant

# ---- Embeddings (HuggingFace) ----------------------------------------------
# Optional: only needed for gated/private models. The default embedding model
# (all-MiniLM-L6-v2) downloads without a token.
HUGGINGFACEHUB_API_TOKEN=
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---- Postgres (Docker infra) ------------------------------------------------
POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=anime
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://anime:anime@localhost:5433/anime

# ---- Redis (Docker infra) — cache + ingestion job broker --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Chroma vector store (file-based, owned by vectorstore-service) ---------
CHROMA_PERSIST_DIR=./.chroma_db

# ---- Inter-service base URLs (native uvicorn dev) ---------------------------
VECTORSTORE_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
RECOMMENDER_SERVICE_URL=http://localhost:8003

# ---- Service ports (native uvicorn dev) -------------------------------------
VECTORSTORE_SERVICE_PORT=8001
INGESTION_SERVICE_PORT=8002
RECOMMENDER_SERVICE_PORT=8003

# ---- Recommendation cache ---------------------------------------------------
RECOMMENDATION_CACHE_TTL_SECONDS=86400
RECOMMENDATION_TOP_K=5

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# Elasticsearch (ELK log sink). Leave ELASTICSEARCH_URL empty to disable ES shipping.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=anime-logs
# OpenTelemetry traces → Jaeger (OTLP/HTTP). Leave empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
